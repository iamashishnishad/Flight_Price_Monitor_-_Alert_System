{
  "info": {
    "name": "PulseNotify - Flight Price Monitor & Alert System",
    "description": "All PulseNotify scenarios. Run the folders in order (Collection Runner). Before running the Admin folder, create an admin with `python manage.py promote_admin <username>` and set the admin_username / admin_password collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "01 Register - success (201)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"email\": \"{{username}}@example.com\",\n  \"role\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Unique username per run so the collection can be re-run",
                  "pm.collectionVariables.set('username', 'alice_' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const data = pm.response.json();",
                  "pm.test('Returns username, access token and role', () => {",
                  "    pm.expect(data).to.have.property('access');",
                  "    pm.expect(data.username).to.eql(pm.collectionVariables.get('username'));",
                  "});",
                  "pm.test('Role is always user (role in body is ignored)', () => pm.expect(data.role).to.eql('user'));",
                  "pm.collectionVariables.set('user_token', data.access);",
                  "}"
                ]
              }
            }
          ]
        },
