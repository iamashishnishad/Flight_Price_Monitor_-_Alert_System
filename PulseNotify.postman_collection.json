            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.test('Route echoed and price within 3000-7000', () => {",
                  "    pm.expect(data.route).to.eql('DEL-BOM');",
                  "    pm.expect(data.price).to.be.within(3000, 7000);",
                  "});",
                  "}"
                ]
              }
            }
          ]
