                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ username: 'bob_' + Date.now(), password: pm.collectionVariables.get('password') }) }",
                  "}, (err, res) => { pm.collectionVariables.set('other_token', res.json().access); });"
                ]
